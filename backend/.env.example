PORT=4000
MONGODB_URI=mongodb://localhost:27017/bookleaf

# Optional: passwords used by npm run seed
SEED_AUTHOR_PASSWORD=author123
SEED_ADMIN_PASSWORD=admin123

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Gemini API (leave blank to use keyword fallback classification)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
